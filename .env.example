# ==========================================
# Peer-to-Peer Meeting Environment Variables
# ==========================================

# 1. Sign in to your Supabase dashboard: https://supabase.com/dashboard
# 2. Select or create a project
# 3. Go to Project Settings -> API
# 4. Copy the "Project URL" and "anon public" API Key

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public API Key (starts with eyJhbGciOi...)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note: The app also allows entering these credentials directly in the in-app
# Settings modal during runtime, which saves them to browser localStorage.
